# Configure on server only. Do not put credentials in Expo public variables.
AUTH_ISSUER=https://YOUR-IDENTITY-PROVIDER/
AUTH_AUDIENCE=kotak-tv
AUTH_JWKS_URL=https://YOUR-IDENTITY-PROVIDER/.well-known/jwks.json
GOOGLE_CREDENTIALS_FILE=/private/google-play-service-account.json
ANDROID_PACKAGE=com.kotaktv.app
DATABASE_PATH=/persistent/kotak-billing.sqlite
PORT=8080
ADMIN_SUBJECTS=
