{
  "expo": {
    "name": "Kotak TV",
    "slug": "kotak-tv",
    "version": "1.0.5",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kotaktv.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.kotaktv.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "./plugins/withCleartext.js",
      "./plugins/withCacheSize.js",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kotak TV sesli arama için mikrofonu kullanır.",
          "speechRecognitionPermission": "Söylediğiniz kanal, film veya diziyi bulmak için konuşma tanıma kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "epg"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f8ce60f3-ea52-4636-8261-29edf0f14630"
      }
    },
    "owner": "kotak618900"
  }
}
